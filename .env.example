# Copy to .env for local work. Never commit .env.

# Port the server listens on.
PORT=3000

# Where the SQLite file lives. On a host, point this at a persistent volume.
DATABASE_PATH=./data/project1.db

# Set to production on the real host. Turns on Secure cookies.
NODE_ENV=development

# Behind a proxy (Railway, Render, nginx), set to 1 so the real visitor IP is used.
# TRUST_PROXY=1

# The website's address, if the public form is served from another origin.
# ALLOWED_ORIGIN=https://example.com

# The public pages ask search engines not to index them until this is true. Set it at launch, when the text is final.
# ALLOW_INDEXING=true

# The contact email shown in the footer and on the Privacy page (where people ask for deletion).
# Until it is set, the pages show "[contact email to be added]".
CONTACT_EMAIL=

# Email to you for each new enquiry. Needs an SMTP account from any email provider.
# SMTP_URL looks like smtps://username:password@smtp.example.com:465 (treat it as a secret).
# PUBLIC_URL is the website's address, used for the "Open it" link in the email.
# Off until NOTIFY_EMAIL and SMTP_URL are both set.
NOTIFY_EMAIL=
SMTP_URL=
MAIL_FROM=
PUBLIC_URL=

# The one admin. Used only when no admin exists yet (first start), or by `npm run set-admin`.
# Password must be at least 12 characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=
