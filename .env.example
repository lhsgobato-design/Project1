# Copy to .env for local work. Never commit .env.

# Port the server listens on.
PORT=3000

# Where the SQLite file lives. On a host, point this at a persistent volume.
DATABASE_PATH=./data/project1.db

# Set to production on the real host. Turns on Secure cookies.
NODE_ENV=development

# Behind a proxy (Railway, Render, nginx), set to 1 so the real visitor IP is used.
# TRUST_PROXY=1

# The website's address, if the public form is served from another origin.
# ALLOWED_ORIGIN=https://example.com

# The public pages ask search engines not to index them until this is true. Set it at launch, when the text is final.
# ALLOW_INDEXING=true

# The contact email shown in the footer and on the Privacy page (where people ask for deletion).
# Until it is set, the pages show "[contact email to be added]".
CONTACT_EMAIL=

# Who is responsible for the data. Shown on the Privacy page and next to the form (GDPR Article 13, LOPDGDD Article 11).
# Until they are set, the pages show "[... to be added]". Tax ID is optional (leave empty if you are not registered yet).
CONTROLLER_NAME=
CONTROLLER_ADDRESS=
CONTROLLER_TAX_ID=
# How long you keep enquiries, as a sentence, for example: 12 months after your last message
RETENTION_PERIOD=

# Email to you for each new enquiry. Off until NOTIFY_EMAIL and one way of sending are set.
# Option 1, works everywhere (Railway Free, Trial and Hobby plans block SMTP): an API key from resend.com.
#   Make the Resend account with the same address as NOTIFY_EMAIL, so its shared sender can write to it.
# Option 2, only where the host allows outgoing SMTP: SMTP_URL like smtps://user:password@smtp.example.com:465
# Treat both keys as secrets. MAIL_FROM is optional. PUBLIC_URL is used for the "Open it" link in the email.
NOTIFY_EMAIL=
RESEND_API_KEY=
SMTP_URL=
MAIL_FROM=
PUBLIC_URL=

# The one admin. Used only when no admin exists yet (first start), or by `npm run set-admin`.
# Password must be at least 12 characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Set to true for one start to replace the admin with the two values above (forgotten password).
# Remove it straight after: while it is set, every restart signs the admin out.
# ADMIN_RESET=true
