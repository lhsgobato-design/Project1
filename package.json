{
  "name": "project1-admin",
  "version": "0.1.0",
  "private": true,
  "description": "project1 website backend: public enquiry endpoint and the admin side where Luis follows up each enquiry.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --disable-warning=ExperimentalWarning --env-file-if-exists=.env src/server.js",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/*.test.js\"",
    "set-admin": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env scripts/set-admin.js",
    "seed:demo": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env scripts/seed-demo.js"
  },
  "dependencies": {
    "express": "^4.21.2",
    "nodemailer": "^10.6.0"
  }
}
